# Clean installs (`npm ci`) must resolve identically across every environment:
# local, the CI container, the Docker build, and Vercel's builder. The test
# toolchain (vitest 5 / vite 8) declares a peer of `@types/node >=22`, while the
# project pins `@types/node@^20`. Newer npm tolerates this; npm 10 (shipped in
# the node:22 images and used by Vercel) fails it with ERESOLVE. This flag makes
# the install deterministic everywhere. It does not change the installed tree —
# `npm ci` still installs exactly what `package-lock.json` pins.
legacy-peer-deps=true
