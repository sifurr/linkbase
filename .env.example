# MongoDB connection string (Mongoose). Include the database name in the path.
# Local:  mongodb://127.0.0.1:27017/linkbase
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/linkbase?retryWrites=true&w=majority
MONGODB_URI=

# Separate database for end-to-end QA (the run-qa-suite skill). Lives in
# .env.test; the DB name must end in -test so QA never touches dev/prod data.
# The app always reads MONGODB_URI, so QA launches the server with
# MONGODB_URI set to this value.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/linkbase-test

# NextAuth / Auth.js secret used to sign session JWTs and cookies.
# Generate one with:  npx auth secret
AUTH_SECRET=

# Canonical app URL. Optional in local dev (defaults to http://localhost:3000);
# set it in production/preview deployments.
# AUTH_URL=http://localhost:3000
