{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-env-edits.js",
            "statusMessage": "Checking protected env files..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@anthropic-plugin-directory": true
  }
}
